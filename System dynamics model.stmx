<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee" uses_arrays="1"/>
		<name>System dynamics model</name>
		<uuid>eed773d1-f4f7-4725-8d05-452b96d4f2dc</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.2" isee:build_number="2856" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.0230769" isee:restore_on_start="false" method="Euler" time_units="Months" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>-5</start>
		<stop>60</stop>
		<dt reciprocal="true">10</dt>
	</sim_specs>
	<dimensions>
		<dim name="Ambiental" size="5"/>
		<dim name="Económico" size="2"/>
		<dim name="IndicadorComplejo" size="3"/>
		<dim name="Social" size="4"/>
	</dimensions>
	<isee:prefs saved_runs="12" keep="true" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="true" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" rifp="false"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format delimit_000s="true"/>
	<data>
		<export frequency="on_demand" resource="r../Scenario analysis.xlsx" type="Excel" worksheet="BAU" interval="1" precomputed="false" isee:format="numbers">
			<table name="EscenariosResultados"/>
		</export>
		<import isee:overwrite="true" orientation="horizontal" resource="r../Input data.xlsx" type="Excel" worksheet=""/>
	</data>
	<isee:sensi_specs_list active_index="1">
		<isee:sensi_specs name="Emsiones GEI Factores" method="sobol_sequence" runs="5">
			<isee:variable type="uniform" min="50" max="500" seed="12345" name="PEFgr" num_samples="5"/>
			<isee:variable type="uniform" min="0.00005" max="0.0005" seed="123" name="TEF" num_samples="5"/>
			<isee:variable type="uniform" min="0.00005" max="0.0005" seed="123" name="WEF" num_samples="5"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="BAU" method="external" sheet="BAU" path="r../Sensitivity parameters.xlsx">
			<isee:variable type="adhoc" name="PIRM"/>
			<isee:variable type="adhoc" name="PDRM"/>
			<isee:variable type="adhoc" name="PCU"/>
			<isee:variable type="adhoc" name="STi"/>
			<isee:variable type="adhoc" name="UW"/>
			<isee:variable type="adhoc" name="DSCT"/>
			<isee:variable type="adhoc" name="PFCE"/>
			<isee:variable type="adhoc" name="PWCA"/>
			<isee:variable type="adhoc" name="PWD"/>
			<isee:variable type="adhoc" name="PMW"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="BAV-OP" method="external" sheet="BAV-OP" path="r../Sensitivity parameters.xlsx">
			<isee:variable type="adhoc" name="PIRM"/>
			<isee:variable type="adhoc" name="PDRM"/>
			<isee:variable type="adhoc" name="PCU"/>
			<isee:variable type="adhoc" name="STi"/>
			<isee:variable type="adhoc" name="UW"/>
			<isee:variable type="adhoc" name="DSCT"/>
			<isee:variable type="adhoc" name="PFCE"/>
			<isee:variable type="adhoc" name="PWCA"/>
			<isee:variable type="adhoc" name="PWD"/>
			<isee:variable type="adhoc" name="PMW"/>
			<isee:variable type="adhoc" name="NOr"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="BAV-PE" method="external" sheet="BAV-PE" path="r../Sensitivity parameters.xlsx">
			<isee:variable type="adhoc" name="PIRM"/>
			<isee:variable type="adhoc" name="PDRM"/>
			<isee:variable type="adhoc" name="PCU"/>
			<isee:variable type="adhoc" name="STi"/>
			<isee:variable type="adhoc" name="UW"/>
			<isee:variable type="adhoc" name="DSCT"/>
			<isee:variable type="adhoc" name="PFCE"/>
			<isee:variable type="adhoc" name="PWCA"/>
			<isee:variable type="adhoc" name="PWD"/>
			<isee:variable type="adhoc" name="PMW"/>
			<isee:variable type="adhoc" name="NOr"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="BAU-OP-PE" method="external" sheet="BAU-OP-PE" path="r../Sensitivity parameters.xlsx">
			<isee:variable type="adhoc" name="PIRM"/>
			<isee:variable type="adhoc" name="PDRM"/>
			<isee:variable type="adhoc" name="PCU"/>
			<isee:variable type="adhoc" name="STi"/>
			<isee:variable type="adhoc" name="UW"/>
			<isee:variable type="adhoc" name="DSCT"/>
			<isee:variable type="adhoc" name="PFCE"/>
			<isee:variable type="adhoc" name="PWCA"/>
			<isee:variable type="adhoc" name="PWD"/>
			<isee:variable type="adhoc" name="PMW"/>
			<isee:variable type="adhoc" name="NOr"/>
		</isee:sensi_specs>
	</isee:sensi_specs_list>
	<isee:optimizer_specs_list active_index="0">
		<isee:optimizer_specs name="Optimization" method="Powell" use_additional_starts_file="false" additional_starts="0" report_interval="1" confidence_range="0">
			<isee:parameter name="PIRM" min="0" max="1"/>
			<isee:parameter name="PDRM" min="0" max="1"/>
			<isee:parameter name="PCU" min="0" max="2000"/>
			<isee:payoff name="EnviI" action="max"/>
		</isee:optimizer_specs>
	</isee:optimizer_specs_list>
	<isee:payoff_specs_list>
		<isee:payoff_specs name="EnviI">
			<isee:payoff_element name="EnviI" weight="-1">
				<isee:time_range type="terminal_value"/>
			</isee:payoff_element>
		</isee:payoff_specs>
	</isee:payoff_specs_list>
	<model_units>
		<unit name="Tons">
			<eqn/>
			<alias>ton</alias>
		</unit>
		<unit name="Months">
			<eqn/>
			<alias>mo</alias>
			<alias>month</alias>
		</unit>
		<unit name="Per Month">
			<eqn>1/Months</eqn>
		</unit>
		<unit name="US Dollars">
			<eqn/>
			<alias>USD</alias>
			<alias>$</alias>
		</unit>
		<unit name="Trabajadores">
			<eqn/>
			<alias>Trabajador</alias>
		</unit>
		<unit name="Unidades">
			<eqn/>
			<alias>Unidad</alias>
		</unit>
		<unit name="Machines">
			<eqn/>
			<alias>Machine</alias>
		</unit>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
		</unit>
		<unit name="kilowatt hours per day">
			<eqn>kWh/day</eqn>
		</unit>
		<unit name="kilowatts">
			<eqn>kW</eqn>
			<alias>kilowatt</alias>
		</unit>
	</model_units>
	<model>
		<isee:extra_collection_variables>
			<isee:extra_collection_variable name="Pt"/>
			<isee:extra_collection_variable name="EnviI_Cum_Avg"/>
			<isee:extra_collection_variable name="EcoI_Cum_Avg"/>
			<isee:extra_collection_variable name="CPI_Accum_Flow"/>
			<isee:extra_collection_variable name="SocI_Cum_Avg"/>
			<isee:extra_collection_variable name="EnviI_Accum_Stock"/>
			<isee:extra_collection_variable name="CPI_Accum_Stock"/>
			<isee:extra_collection_variable name="CPI_Cum_Avg"/>
			<isee:extra_collection_variable name="WW"/>
			<isee:extra_collection_variable name="SR"/>
			<isee:extra_collection_variable name="ED"/>
			<isee:extra_collection_variable name="D"/>
			<isee:extra_collection_variable name="Ords"/>
			<isee:extra_collection_variable name="SocI"/>
			<isee:extra_collection_variable name="SocI_Accum_Stock"/>
			<isee:extra_collection_variable name="PrN"/>
			<isee:extra_collection_variable name="EcoI_Accum_Flow"/>
			<isee:extra_collection_variable name="MW"/>
			<isee:extra_collection_variable name="EnviI"/>
			<isee:extra_collection_variable name="EnvI_Accum_Flow"/>
			<isee:extra_collection_variable name="SocI_Accum_Flow"/>
			<isee:extra_collection_variable name="CPI"/>
			<isee:extra_collection_variable name="EcoI_Accum_Stock"/>
		</isee:extra_collection_variables>
		<variables>
			<stock name="St">
				<doc>Stock </doc>
				<eqn>0</eqn>
				<inflow>Pr</inflow>
				<outflow>De</outflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<flow name="Pr">
				<doc>Production</doc>
				<eqn>MIN(PrN,MIN(MIN(IPM/MRIM, IPM),MIN(DPM/MRDM, DPM))/PrT)</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<flow name="De">
				<doc>Deliveries</doc>
				<eqn>MIN(St/STi, D)</eqn>
				<non_negative/>
				<units>unidades/mo</units>
			</flow>
			<aux name="DP">
				<doc>Desired Production</doc>
				<eqn>MAX(D+SC, 0)</eqn>
				<units>Unidades/mo</units>
			</aux>
			<aux name="SC">
				<doc>Stock Corrector </doc>
				<eqn>(DS-St)/TCS</eqn>
				<units>Unidades/Mo</units>
			</aux>
			<aux name="TCS">
				<doc>Time to Correct Stock</doc>
				<eqn>0.5</eqn>
				<units>Mo</units>
			</aux>
			<aux name="DS">
				<doc>Desired Stock </doc>
				<eqn>D*DSCT</eqn>
				<units>Unidades</units>
			</aux>
			<aux name="AOT">
				<doc>Average Order Time </doc>
				<eqn>12</eqn>
				<units>Mo</units>
			</aux>
			<aux name="DSCT">
				<doc>Desired Stock Coverage Time </doc>
				<eqn>1</eqn>
				<units>Mo</units>
			</aux>
			<aux name="NOr">
				<doc>New Orders</doc>
				<eqn>0.5</eqn>
				<format display_as="percent"/>
				<units>Per Month</units>
			</aux>
			<aux name="PrN">
				<doc>Normal Production </doc>
				<eqn>W*Pt</eqn>
				<units>Unidades/mo</units>
			</aux>
			<aux name="UW">
				<doc>Units per Worker </doc>
				<eqn>20</eqn>
				<units>Unidades/(mo*Trabajador)</units>
			</aux>
			<aux name="ED">
				<doc>Expected Demand</doc>
				<eqn>SMTH1(Ords,AOT)</eqn>
				<units>Unidades</units>
			</aux>
			<aux name="DEW">
				<doc>Desired Employee Workforce </doc>
				<eqn>SMTH1(DP/Pt,  ATDEW)</eqn>
				<units>Trabajadores</units>
			</aux>
			<stock name="W">
				<doc>Workers</doc>
				<eqn>50</eqn>
				<inflow>HIR</inflow>
				<inflow>Recv</inflow>
				<outflow>DIS</outflow>
				<outflow>Inc</outflow>
				<non_negative/>
				<units>Trabajadores</units>
			</stock>
			<flow name="DIS">
				<doc>Dismissals </doc>
				<eqn>W/WRT+MAX(-HN, 0)</eqn>
				<non_negative/>
				<units>trabajadores/mo</units>
			</flow>
			<flow name="HIR">
				<doc>Hiring</doc>
				<eqn>MAX(HN, 0)</eqn>
				<non_negative/>
				<units>trabajadores/mo</units>
			</flow>
			<aux name="WRT">
				<doc>Workers Rotation Time </doc>
				<eqn>54</eqn>
				<units>mo</units>
			</aux>
			<aux name="HN">
				<doc>Hiring Need</doc>
				<eqn>(DEW-TWr)/ HT</eqn>
				<units>Trabajadores/mo</units>
			</aux>
			<aux name="HT">
				<doc>Hiring Time</doc>
				<eqn>3</eqn>
				<units>mo</units>
			</aux>
			<aux name="PIRM">
				<doc>Percentage of Indirect Recycled Materials</doc>
				<eqn>10</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<stock name="IM">
				<doc>Indirect Materials on the Way</doc>
				<eqn>200</eqn>
				<inflow>IRM</inflow>
				<inflow>NIM</inflow>
				<outflow>IMD</outflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<flow name="IRM">
				<doc>Indirect Recycled Materials</doc>
				<eqn>IMO*PIRM/100</eqn>
				<non_negative/>
				<units>unidades/mo</units>
			</flow>
			<flow name="NIM">
				<doc>New Indirect Materials </doc>
				<eqn>IMO*(1-PIRM/100)</eqn>
				<non_negative/>
				<units>unidades/mo</units>
			</flow>
			<flow name="IMD">
				<doc>Indirect Materials Delivery </doc>
				<eqn>MAX(IM/DelTi, 0)</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<aux name="IMCr">
				<doc>Indirect Materials Corrector</doc>
				<eqn>(DIM-IPM)/TCIM</eqn>
				<units>Unidades/mo</units>
			</aux>
			<aux name="TCIM">
				<doc>Time to Correct Indirect Materials</doc>
				<eqn>2</eqn>
				<units>mo</units>
			</aux>
			<aux name="IMCT">
				<doc>Indirect Material Coverage Time</doc>
				<eqn>1</eqn>
				<units>Mo</units>
			</aux>
			<aux name="DIM">
				<doc>Desired Indirect Materials </doc>
				<eqn>DP*IMCT*MRDM</eqn>
				<units>Unidades</units>
			</aux>
			<aux name="IMO">
				<doc>Indirect Material Orders</doc>
				<eqn>MAX(DP*MRIM+IMCr, 0)</eqn>
				<units>Unidades/mo</units>
			</aux>
			<stock name="DM">
				<doc>Direct Materials on the Way</doc>
				<eqn>100</eqn>
				<inflow>DMP</inflow>
				<inflow>DRM</inflow>
				<outflow>DMD</outflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<flow name="DMD">
				<doc>Direct Materials Delivery</doc>
				<eqn>MAX(DM/DelTi, 0)</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<flow name="DMP">
				<doc>Direct Materials Purchased</doc>
				<eqn>DMO*(1-PDRM/100)</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<aux name="DMCr">
				<doc>Direct Materials Corrector</doc>
				<eqn>(DDM-DPM)/TCDM</eqn>
				<units>Unidades/mo</units>
			</aux>
			<aux name="DDM">
				<doc>Desired Direct Materials</doc>
				<eqn>DP*DMCT*MRDM</eqn>
				<units>Unidades</units>
			</aux>
			<aux name="DMCT">
				<doc>Direct Materials Coverage Time</doc>
				<eqn>1</eqn>
				<units>Months</units>
			</aux>
			<aux name="TCDM">
				<doc>Time to Correct Direct Materials</doc>
				<eqn>2</eqn>
				<units>Mo</units>
			</aux>
			<aux name="DMO">
				<doc>Direct Materials Orders</doc>
				<eqn>MAX(DP*MRDM+DMCr, 0)</eqn>
				<units>Unidades/mo</units>
			</aux>
			<stock name="IPM">
				<doc>Indirect Production Materials </doc>
				<eqn>0</eqn>
				<inflow>IMD</inflow>
				<outflow>IMC</outflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<aux name="ECU">
				<doc>Energy Consumption per Unit</doc>
				<eqn>17.21</eqn>
				<format precision="1" scale_by="1" display_as="currency"/>
				<units>US Dollars/unidades</units>
			</aux>
			<aux name="TEC" flow_concept="true">
				<doc>Total Energy Consumption</doc>
				<eqn>Pr*ECU</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="WUP">
				<doc>Waste per Unit Produced</doc>
				<eqn>5</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="PWCA">
				<doc>Percentage of Workers in Collective Agreements </doc>
				<eqn>10</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="WCA">
				<doc>Workers in Collective Agreements </doc>
				<eqn>TWr*PWCA/100</eqn>
				<units>Trabajadores</units>
			</aux>
			<aux name="ACAP">
				<doc>Affectation of Collective Agreements to Productivity</doc>
				<eqn>PWCA/100</eqn>
				<gf>
					<yscale min="0.8" max="1"/>
					<xpts>0,0.111111111111111,0.222222222222222,0.333333333333333,0.444444444444444,0.555555555555556,0.666666666666667,0.777777777777778,0.888888888888889,1</xpts>
					<ypts>1,0.977777777777778,0.955555555555556,0.933333333333333,0.911111111111111,0.888888888888889,0.866666666666667,0.844444444444445,0.822222222222222,0.8</ypts>
				</gf>
				<units>unitless</units>
			</aux>
			<aux name="Pt">
				<doc>Productivity</doc>
				<eqn>UW*ACAP*APDP*AFCE</eqn>
				<units>Unidades/(mo*trabajadores)</units>
			</aux>
			<aux name="PWD">
				<doc>Probability of Worker Disease 

Source: https://www.larepublica.co/finanzas/los-sectores-economicos-con-las-tasas-mas-altas-de-enfermedades-de-origen-laboral-3067208
https://oiss.org/wp-content/uploads/2022/01/Colombia-fasecolda.pdf</doc>
				<eqn>6.75</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="OD">
				<doc>Occupational Diseases</doc>
				<eqn>PWD/100*W</eqn>
				<units>Trabajadores</units>
			</aux>
			<aux name="APDP">
				<doc>Affectation of Professional Diseases to Productivity </doc>
				<eqn>PWD/100</eqn>
				<gf>
					<yscale min="0.8" max="1"/>
					<xpts>0,0.0075,0.015,0.0225,0.03,0.0375,0.045,0.0525,0.06,0.0675</xpts>
					<ypts>1,0.977777777777778,0.955555555555556,0.933333333333333,0.911111111111111,0.888888888888889,0.866666666666667,0.844444444444445,0.822222222222222,0.8</ypts>
				</gf>
				<units>unitless</units>
			</aux>
			<aux name="D">
				<doc>Demand</doc>
				<eqn>ED*DI</eqn>
				<units>Unidades/mo</units>
			</aux>
			<aux name="MW">
				<doc>Men Workers</doc>
				<eqn>W*PMW/100</eqn>
				<units>Trabajadores</units>
			</aux>
			<aux name="WW">
				<doc>Women
Workers</doc>
				<eqn>W*(1-PMW/100)</eqn>
				<units>Trabajadores</units>
			</aux>
			<aux name="MS">
				<doc>Men Salary</doc>
				<eqn>270</eqn>
				<format precision="1" scale_by="1" display_as="currency"/>
				<units>US Dollars/(mo*Trabajador)</units>
			</aux>
			<aux name="WS">
				<doc>Women Salary</doc>
				<eqn>240</eqn>
				<format precision="1" scale_by="1" display_as="currency"/>
				<units>US Dollars/(mo*Trabajador)</units>
			</aux>
			<aux name="MSC">
				<doc>Men&apos;s Salary Cost</doc>
				<eqn>MW*MS</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="WSC">
				<doc>Women&apos;s Salary Cost</doc>
				<eqn>WW*WS</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="PMW">
				<doc>Percentage of Male Workers</doc>
				<eqn>59</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="PFCE">
				<doc>Probability of Faults to the Code of Ethics</doc>
				<eqn>1.5</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="FCE">
				<doc>Faults to the Code of Ethics</doc>
				<eqn>W*PFCE/100</eqn>
				<units>Trabajadores</units>
			</aux>
			<aux name="AFCE">
				<doc>Affectation of the Faults to the Code of Ethics </doc>
				<eqn>PFCE/100</eqn>
				<gf>
					<yscale min="0" max="1"/>
					<xpts>0,0.111111111111111,0.222222222222222,0.333333333333333,0.444444444444444,0.555555555555556,0.666666666666667,0.777777777777778,0.888888888888889,1</xpts>
					<ypts>1,0.835051546391753,0.656357388316151,0.501718213058419,0.378006872852234,0.285223367697594,0.195876288659794,0.116838487972509,0.0481099656357388,0</ypts>
				</gf>
				<units>unitless</units>
			</aux>
			<aux name="SVU">
				<doc>Sales Value per Unit</doc>
				<eqn>780</eqn>
				<format scale_by="1" display_as="currency"/>
				<units>US Dollars/Unidad</units>
			</aux>
			<aux name="SR" flow_concept="true">
				<doc>Sales Revenue</doc>
				<eqn>De*SVU</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="PCU">
				<doc>Production Cost per Unit </doc>
				<eqn>520</eqn>
				<format scale_by="1" display_as="currency"/>
				<units>US Dollars/Unidad</units>
			</aux>
			<aux name="PC" flow_concept="true">
				<doc>Production Costs </doc>
				<eqn>Pr*PCU</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="TSC">
				<doc>Total Salary Cost </doc>
				<eqn>SMTH1(MSC+WSC, T)</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="WTC">
				<doc>Waste Treatment Cost</doc>
				<eqn>2600</eqn>
				<format display_as="currency"/>
				<units>US Dollars/Unidad</units>
			</aux>
			<aux name="TCWD">
				<doc>Total Cost of Waste Disposal</doc>
				<eqn>WP*WTC</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="TPC">
				<doc>Total Production Cost</doc>
				<eqn>PC+TSC+TCWD</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="EBIT">
				<doc>Earnings before interest and taxes</doc>
				<eqn>SR-TPC-WCAC-FCEC-ODC</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="EnviI">
				<eqn>SUM(EnviKPIsW)+100*SUM(IF(EnviWeights&lt;0) THEN -EnviWeights ELSE 0)/SUM(ABS(EnviWeights))</eqn>
				<format scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="SocI">
				<eqn>SUM(SocKPIsW)+100*SUM(IF(SocWeights&lt;0) THEN -SocWeights ELSE 0)/SUM(ABS(SocWeights))</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="Ecol">
				<eqn>SUM(EcoKPIsW)+100*SUM(IF(EcoWeights&lt;0) THEN -EcoWeights ELSE 0)/SUM(ABS(EcoWeights))</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="CPI">
				<doc>Complex performance indicator</doc>
				<eqn>(CPIWeights[1]*EnviI+CPIWeights[2]*SocI+CPIWeights[3]*Ecol)/SUM(CPIWeights)</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="DI">
				<doc>Demand Increase</doc>
				<eqn>1</eqn>
				<units>Per Month</units>
			</aux>
			<stock name="Ords">
				<doc>Orders</doc>
				<eqn>10000</eqn>
				<inflow>NOrI</inflow>
				<units>Unidades</units>
			</stock>
			<flow name="NOrI">
				<doc>New Orders Increase </doc>
				<eqn>Ords*NOr/100</eqn>
				<units>Unidades/Mo</units>
			</flow>
			<flow name="EnvI Accum\nFlow">
				<doc>Change&apos;s rate of environmental indicator</doc>
				<eqn>IF TIME &gt;= 0 THEN EnviI/DT  ELSE 0</eqn>
				<non_negative/>
				<units>Per Month</units>
			</flow>
			<stock name="EnviI Accum\nStock">
				<doc>State of economic indicator</doc>
				<eqn>0</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<inflow>EnvI_Accum_Flow</inflow>
				<units>unitless</units>
			</stock>
			<aux name="EnviI Cum\nAvg">
				<doc>Average environmental indicator</doc>
				<eqn>SAFEDIV(DT*EnviI_Accum_Stock, TIME, 0)</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<flow name="SocI Accum\nFlow">
				<doc>Change&apos;s rate of social indicator</doc>
				<eqn>IF TIME &gt;= 0 THEN SocI/DT ELSE 0</eqn>
				<units>Per Month</units>
			</flow>
			<stock name="SocI Accum\nStock">
				<doc>State of social indicator</doc>
				<eqn>0</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<inflow>SocI_Accum_Flow</inflow>
				<units>unitless</units>
			</stock>
			<aux name="SocI Cum\nAvg">
				<doc>Average social indicator</doc>
				<eqn>SAFEDIV(DT*SocI_Accum_Stock, TIME, 0)</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<flow name="EcoI Accum\nFlow">
				<doc>Change&apos;s rate of economic indicator</doc>
				<eqn>IF TIME &gt;= 0 THEN Ecol/DT ELSE 0</eqn>
				<units>Per Month</units>
			</flow>
			<stock name="EcoI Accum\nStock">
				<doc>State of economic indicator</doc>
				<eqn>0</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<inflow>EcoI_Accum_Flow</inflow>
				<units>unitless</units>
			</stock>
			<aux name="EcoI Cum\nAvg">
				<doc>Average economic indicator</doc>
				<eqn>SAFEDIV(DT*EcoI_Accum_Stock, TIME, 0)</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<flow name="CPI Accum\nFlow">
				<doc>Change&apos;s Rate of CPI</doc>
				<eqn>IF TIME &gt;= 0 THEN CPI/DT ELSE 0</eqn>
				<units>Per Month</units>
			</flow>
			<stock name="CPI Accum\nStock">
				<doc>State of CPI indicator</doc>
				<eqn>0</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<inflow>CPI_Accum_Flow</inflow>
				<units>unitless</units>
			</stock>
			<aux name="CPI Cum\nAvg">
				<doc>Average CPI</doc>
				<eqn>SAFEDIV(DT*CPI_Accum_Stock, TIME, 0)</eqn>
				<format precision="0.01" scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<group name="Social KPIs" run="true">
				<format delimit_000s="false"/>
				<entity name="SocBenchs"/>
				<entity name="SocWeights"/>
				<entity name="SocKPIs"/>
				<entity name="MaxSocKPI"/>
				<entity name="SocI"/>
				<entity name="SocKPIsW"/>
			</group>
			<group name="Economic KPIs" run="true">
				<format delimit_000s="false"/>
				<entity name="IA"/>
				<entity name="ROAMT"/>
				<entity name="MaxEcoKPI"/>
				<entity name="EBIT"/>
				<entity name="EcoWeights"/>
				<entity name="AER"/>
				<entity name="EcoKPIsW"/>
				<entity name="Ecol"/>
				<entity name="EcoBenchs"/>
				<entity name="EcoKPIs"/>
				<entity name="A"/>
			</group>
			<group name="Workers sub-model" run="true">
				<format delimit_000s="false"/>
				<entity name="W"/>
				<entity name="Recv"/>
				<entity name="TWr"/>
				<entity name="ATDEW"/>
				<entity name="AFCE"/>
				<entity name="WSC"/>
				<entity name="PFCE"/>
				<entity name="MW"/>
				<entity name="HT"/>
				<entity name="MS"/>
				<entity name="MSC"/>
				<entity name="OD"/>
				<entity name="DEW"/>
				<entity name="APDP"/>
				<entity name="ODC"/>
				<entity name="WW"/>
				<entity name="WCAC"/>
				<entity name="Pt"/>
				<entity name="DIS"/>
				<entity name="RT"/>
				<entity name="Inc"/>
				<entity name="FCEC"/>
				<entity name="WCA"/>
				<entity name="T"/>
				<entity name="MODC"/>
				<entity name="PMW"/>
				<entity name="HN"/>
				<entity name="FCE"/>
				<entity name="WS"/>
				<entity name="UW"/>
				<entity name="PWCA"/>
				<entity name="DW"/>
				<entity name="MFCEC"/>
				<entity name="PWD"/>
				<entity name="ACAP"/>
				<entity name="TSC"/>
				<entity name="DR"/>
				<entity name="HIR"/>
				<entity name="WRT"/>
				<entity name="MWCAC"/>
			</group>
			<group name="Environmental KPIs" run="true">
				<format delimit_000s="false"/>
				<entity name="EnviWeights"/>
				<entity name="EnviBenchs"/>
				<entity name="EnviKPIs"/>
				<entity name="MaxEnvKPI"/>
				<entity name="TCWD"/>
				<entity name="EnviKPIsW"/>
				<entity name="TEC"/>
				<entity name="ECU"/>
				<entity name="EnviI"/>
				<entity name="WTC"/>
				<entity name="AEFS"/>
			</group>
			<group name="Production sub-model" run="true">
				<format delimit_000s="false"/>
				<entity name="STi"/>
				<entity name="PrT"/>
				<entity name="PIRM"/>
				<entity name="DPM"/>
				<entity name="PrR"/>
				<entity name="PrN"/>
				<entity name="TCS"/>
				<entity name="AOT"/>
				<entity name="WP"/>
				<entity name="DMCT"/>
				<entity name="MRIM"/>
				<entity name="TCIM"/>
				<entity name="NIM"/>
				<entity name="IMO"/>
				<entity name="DDM"/>
				<entity name="PC"/>
				<entity name="TF"/>
				<entity name="DI"/>
				<entity name="MRDM"/>
				<entity name="DP"/>
				<entity name="IMD"/>
				<entity name="SVU"/>
				<entity name="DM"/>
				<entity name="Ords"/>
				<entity name="NOr"/>
				<entity name="RPTC"/>
				<entity name="RPTC_Rate"/>
				<entity name="IM"/>
				<entity name="APr"/>
				<entity name="DelTi"/>
				<entity name="DMP"/>
				<entity name="SC"/>
				<entity name="DIM"/>
				<entity name="WU"/>
				<entity name="DMCr"/>
				<entity name="SR"/>
				<entity name="Pr"/>
				<entity name="D"/>
				<entity name="PWU"/>
				<entity name="DMC"/>
				<entity name="WUP"/>
				<entity name="DRM"/>
				<entity name="TW"/>
				<entity name="DSCT"/>
				<entity name="Cum_RPTC"/>
				<entity name="IMCr"/>
				<entity name="IMC"/>
				<entity name="De"/>
				<entity name="DMO"/>
				<entity name="ED"/>
				<entity name="PCU"/>
				<entity name="NOrI"/>
				<entity name="TCDM"/>
				<entity name="IMCT"/>
				<entity name="IRM"/>
				<entity name="ARPTC"/>
				<entity name="DS"/>
				<entity name="PDRM"/>
				<entity name="DMD"/>
				<entity name="St"/>
				<entity name="TP"/>
				<entity name="IPM"/>
				<entity name="TPC"/>
			</group>
			<group name="Complex Performance Indicator (CPI)" run="true">
				<format delimit_000s="false"/>
				<entity name="CPI"/>
				<entity name="CPIWeights"/>
			</group>
			<aux name="DelTi">
				<doc>Delivery Time </doc>
				<eqn>1</eqn>
				<units>mo</units>
			</aux>
			<aux name="PrT">
				<doc>Production time</doc>
				<eqn>1</eqn>
				<units>mo</units>
			</aux>
			<aux name="MRIM">
				<doc>Marginal Requirement Indirect Materials </doc>
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="STi">
				<doc>Sales time</doc>
				<eqn>1</eqn>
				<units>mo</units>
			</aux>
			<stock name="DPM">
				<doc>Direct Production Materials</doc>
				<eqn>1000</eqn>
				<inflow>DMD</inflow>
				<outflow>DMC</outflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<flow name="IMC">
				<doc>Indirect Materials Consumption</doc>
				<eqn>Pr*MRIM</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<flow name="DMC">
				<doc>Direct Materials Consumption</doc>
				<eqn>Pr*MRDM</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<aux name="MRDM">
				<doc>Marginal Requirement Direct Materials</doc>
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="A">
				<doc>Assets</doc>
				<eqn>IA+TIME*AER</eqn>
				<units>US Dollars</units>
			</aux>
			<aux name="AEFS">
				<doc>Average Emission from sector</doc>
				<eqn>7.8581877412126</eqn>
				<units>Tons/mo</units>
			</aux>
			<group name="Emissions sub-model" run="true">
				<format delimit_000s="false"/>
				<entity name="PrE"/>
				<entity name="CO2_EitA"/>
				<entity name="WEF"/>
				<entity name="NAb"/>
				<entity name="TEF"/>
				<entity name="PrEF"/>
				<entity name="PEFgr"/>
				<entity name="Emi"/>
				<entity name="AbF"/>
				<entity name="TE"/>
				<entity name="grT"/>
				<entity name="WE"/>
			</group>
			<flow name="Emi">
				<doc>Emissions</doc>
				<eqn>WE+PrE+TE</eqn>
				<non_negative/>
				<units>Tons/mo</units>
			</flow>
			<stock name="CO2 EitA">
				<doc>CO2 Emissions in the Atmosphere</doc>
				<eqn>0</eqn>
				<inflow>Emi</inflow>
				<outflow>NAb</outflow>
				<non_negative/>
				<units>Tons</units>
			</stock>
			<flow name="NAb">
				<doc>Natural Absorption</doc>
				<eqn>AbF*CO2_EitA</eqn>
				<non_negative/>
				<units>Tons/mo</units>
			</flow>
			<aux name="WEF">
				<doc>Waste Emissions Factor</doc>
				<eqn>0.0001</eqn>
				<units>Tons/Unidades</units>
			</aux>
			<aux name="WE">
				<doc>Waste Emission</doc>
				<eqn>WEF*WP</eqn>
				<units>Tons/mo</units>
			</aux>
			<aux name="PrEF">
				<doc>Production Emissions Factor</doc>
				<eqn>PEFgr/grT</eqn>
				<units>Tons/Unidades</units>
			</aux>
			<aux name="PrE">
				<doc>Production Emissions</doc>
				<eqn>PrEF*Pr</eqn>
				<units>Tons/mo</units>
			</aux>
			<aux name="TE">
				<doc>Transport Emissions</doc>
				<eqn>(DMD+IMD+De)*TEF</eqn>
				<units>Tons/mo</units>
			</aux>
			<aux name="TEF">
				<doc>Transport Emissions Factor</doc>
				<eqn>0.0001</eqn>
				<units>Tons/Unidades</units>
			</aux>
			<aux name="AbF">
				<doc>Absorption Factor</doc>
				<eqn>SAFEDIV(Emi, CO2_EitA, 0)</eqn>
				<gf>
					<yscale min="0" max="0.5"/>
					<xpts>0,0.0416666666667,0.0833333333333,0.125,0.166666666667,0.208333333333,0.25,0.291666666667,0.333333333333,0.375,0.416666666667,0.458333333333,0.5,0.541666666667,0.583333333333,0.625,0.666666666667,0.708333333333,0.75,0.791666666667,0.833333333333,0.875,0.916666666667,0.958333333333,1</xpts>
					<ypts>0.5,0.423240862445,0.358265655287,0.303265329856,0.256708559516,0.217299104254,0.183939720586,0.155701611957,0.131798569058,0.111565080074,0.0944378014188,0.0799398730398,0.0676676416183,0.0572794219963,0.0484859839322,0.0410424993119,0.0347417256114,0.0294082358212,0.0248935341839,0.0210719217546,0.0178369966736,0.0150986917112,0.0127807666033,0.0108186853597,0.00915781944437</ypts>
				</gf>
				<units>Per Month</units>
			</aux>
			<stock name="TW">
				<doc>Total Waste</doc>
				<eqn>0</eqn>
				<inflow>WP</inflow>
				<outflow>WU</outflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<flow name="WP">
				<doc>Waste Produced</doc>
				<eqn>Pr*WUP/100</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<flow name="PrR">
				<doc>Production Rate</doc>
				<eqn>IF TIME &gt;= 0 THEN TF*Pr/DT ELSE 0</eqn>
				<non_negative/>
				<units>Unidades/Months</units>
			</flow>
			<stock name="TP">
				<doc>Total Production</doc>
				<eqn>0</eqn>
				<inflow>PrR</inflow>
				<non_negative/>
				<units>Unidades</units>
			</stock>
			<aux name="EnviWeights">
				<dimensions>
					<dim name="Ambiental"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.185676392572944</eqn>
				</element>
				<element subscript="2">
					<eqn>-0.209549071618037</eqn>
				</element>
				<element subscript="3">
					<eqn>-0.188328912466843</eqn>
				</element>
				<element subscript="4">
					<eqn>-0.204244031830239</eqn>
				</element>
				<element subscript="5">
					<eqn>-0.212201591511936</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="EnviKPIs">
				<doc>EnviKPI1: Consumption of recycled materials and raw materials.
EnviKPI2: Fuel consumption.
EnviKPI3: Waste production
EnviKPI4: Environmental costs
EnviKPI5: Generation of greenhouse gases.</doc>
				<dimensions>
					<dim name="Ambiental"/>
				</dimensions>
				<element subscript="1">
					<eqn>(IRM+DRM)//(IMC+DMC)*100</eqn>
				</element>
				<element subscript="2">
					<eqn>TEC//TPC*100</eqn>
				</element>
				<element subscript="3">
					<eqn>TW // APr *100</eqn>
				</element>
				<element subscript="4">
					<eqn>TCWD // SR *100</eqn>
				</element>
				<element subscript="5">
					<eqn>Emi // AEFS *100</eqn>
				</element>
				<format scale_by="1" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="EnviKPIsW">
				<dimensions>
					<dim name="Ambiental"/>
				</dimensions>
				<eqn>IF(EnviBenchs &gt; 0) THEN(
    IF(EnviWeights &gt;0) THEN (
        IF(EnviKPIs&lt;=EnviBenchs) THEN(
        EnviWeights/SUM(ABS(EnviWeights))*(EnviKPIs/EnviBenchs)*100)
        ELSE(
        (EnviWeights/SUM(ABS(EnviWeights)))*(EnviKPIs-MaxEnvKPI)/(EnviBenchs-MaxEnvKPI)*100))
    ELSE(        
        IF(EnviKPIs&lt;=EnviBenchs) THEN(
        (EnviWeights/SUM(ABS(EnviWeights)))*(1-EnviKPIs/EnviBenchs)*100)
        ELSE(
        (EnviWeights/SUM(ABS(EnviWeights)))*(1-(EnviKPIs-MaxEnvKPI)/(EnviBenchs-MaxEnvKPI))*100))
)ELSE(EnviWeights/SUM(ABS(EnviWeights))*EnviKPIs)</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="EnviBenchs">
				<dimensions>
					<dim name="Ambiental"/>
				</dimensions>
				<element subscript="1">
					<eqn>0</eqn>
				</element>
				<element subscript="2">
					<eqn>0</eqn>
				</element>
				<element subscript="3">
					<eqn>0</eqn>
				</element>
				<element subscript="4">
					<eqn>0</eqn>
				</element>
				<element subscript="5">
					<eqn>0</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="SocKPIs">
				<doc>SocKPI1: Percentage of employees covered by collective agreement.
SocKPI2: Occupational diseases.
SocKPI3: Wage discrimination.
SocKPI4: Violations of the Code of Ethics.
</doc>
				<dimensions>
					<dim name="Social"/>
				</dimensions>
				<element subscript="1">
					<eqn>WCAC // TSC *100</eqn>
				</element>
				<element subscript="2">
					<eqn>ODC // TSC * 100</eqn>
				</element>
				<element subscript="3">
					<eqn>((MSC-WSC)//TSC+1)*100</eqn>
				</element>
				<element subscript="4">
					<eqn>FCEC // TSC *100</eqn>
				</element>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="SocWeights">
				<dimensions>
					<dim name="Social"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.210332103321033</eqn>
				</element>
				<element subscript="2">
					<eqn>-0.25830258302583</eqn>
				</element>
				<element subscript="3">
					<eqn>-0.239852398523985</eqn>
				</element>
				<element subscript="4">
					<eqn>-0.291512915129151</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="SocBenchs">
				<dimensions>
					<dim name="Social"/>
				</dimensions>
				<element subscript="1">
					<eqn>0</eqn>
				</element>
				<element subscript="2">
					<eqn>0</eqn>
				</element>
				<element subscript="3">
					<eqn>100</eqn>
				</element>
				<element subscript="4">
					<eqn>0</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="SocKPIsW">
				<dimensions>
					<dim name="Social"/>
				</dimensions>
				<eqn>IF(SocBenchs &gt; 0) THEN(
    IF(SocWeights &gt;0) THEN (
        IF(SocKPIs&lt;=SocBenchs) THEN(
        SocWeights/SUM(ABS(SocWeights))*(SocKPIs/SocBenchs)*100)
        ELSE(
        (SocWeights/SUM(ABS(SocWeights)))*(SocKPIs-MaxSocKPI)/(SocBenchs-MaxSocKPI)*100))
    ELSE(        
        IF(SocKPIs&lt;=SocBenchs) THEN(
        (SocWeights/SUM(ABS(SocWeights)))*(1-SocKPIs/SocBenchs)*100)
        ELSE(
        (SocWeights/SUM(ABS(SocWeights)))*(1-(SocKPIs-MaxSocKPI)/(SocBenchs-MaxSocKPI))*100))
)ELSE(SocWeights/SUM(ABS(SocWeights))*SocKPIs)</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="EcoKPIs">
				<doc>EcoKPI1: Gross Profit
EcoKPI2: Return on assets</doc>
				<dimensions>
					<dim name="Económico"/>
				</dimensions>
				<element subscript="1">
					<eqn>SMTH1( MAX(SR-TPC, 0) // SR , 2) *100</eqn>
				</element>
				<element subscript="2">
					<eqn>SMTH1((EBIT*ROAMT)// A, 2)* 100</eqn>
				</element>
				<format precision="0.01" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="EcoWeights">
				<dimensions>
					<dim name="Económico"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.513513513513513</eqn>
				</element>
				<element subscript="2">
					<eqn>0.486486486486487</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="EcoBenchs">
				<dimensions>
					<dim name="Económico"/>
				</dimensions>
				<element subscript="1">
					<eqn>0</eqn>
				</element>
				<element subscript="2">
					<eqn>0</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="EcoKPIsW">
				<dimensions>
					<dim name="Económico"/>
				</dimensions>
				<eqn>IF(EcoBenchs &gt; 0) THEN(
    IF(EcoWeights &gt;0) THEN (
        IF(EcoKPIs&lt;=EcoBenchs) THEN(
        EcoWeights/SUM(ABS(EcoWeights))*(EcoKPIs/EcoBenchs)*100)
        ELSE(
        (EcoWeights/SUM(ABS(EcoWeights)))*(EcoKPIs-MaxEcoKPI)/(EcoBenchs-MaxEcoKPI)*100))
    ELSE(        
        IF(EcoKPIs&lt;=EcoBenchs) THEN(
        (EcoWeights/SUM(ABS(EcoWeights)))*(1-EcoKPIs/EcoBenchs)*100)
        ELSE(
        (EcoWeights/SUM(ABS(EcoWeights)))*(1-(EcoKPIs-MaxEcoKPI)/(EcoBenchs-MaxEcoKPI))*100))
)ELSE(EcoWeights/SUM(ABS(EcoWeights))*EcoKPIs)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="CPIWeights">
				<doc>1: Environmental
2: Social
3: Economic</doc>
				<dimensions>
					<dim name="IndicadorComplejo"/>
				</dimensions>
				<element subscript="1">
					<eqn>0.3375</eqn>
				</element>
				<element subscript="2">
					<eqn>0.5035</eqn>
				</element>
				<element subscript="3">
					<eqn>0.1591</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="PDRM">
				<doc>Percentage of direct Recycled Materials</doc>
				<eqn>5</eqn>
				<format delimit_000s="false" display_as="percent"/>
				<units>unitless</units>
			</aux>
			<flow name="DRM">
				<doc>Direct Recycled Materials</doc>
				<eqn>DMO*PDRM/100</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<flow name="WU">
				<doc>Waste Used</doc>
				<eqn>TW*PWU/100</eqn>
				<non_negative/>
				<units>Unidades/mo</units>
			</flow>
			<aux name="PWU">
				<doc>Percentage of Waste Used
Source:
https://www.larepublica.co/responsabilidad-social/colombia-podria-aprovechar-cerca-de-40-de-los-11-6-millones-de-toneladas-de-residuos-que-genera-al-ano-2813141#:~:text=Actualmente%2C%20en%20Colombia%20se%20generan,se%20recicla%20alrededor%20de%2017%25.</doc>
				<eqn>17</eqn>
				<units>Per Month</units>
			</aux>
			<aux name="APr">
				<doc>Average Production</doc>
				<eqn>SAFEDIV(DT*TP, MAX(TIME, 0), 0)</eqn>
				<units>Unidades</units>
			</aux>
			<aux name="TF">
				<eqn>1</eqn>
				<units>Months</units>
			</aux>
			<stock name="Cum RPTC">
				<doc>State of GP</doc>
				<eqn>0</eqn>
				<inflow>RPTC_Rate</inflow>
				<units>unitless</units>
			</stock>
			<flow name="RPTC Rate">
				<doc>Change&apos;s Rate of GP</doc>
				<eqn>IF TIME &gt;= 0 THEN RPTC/DT ELSE 0</eqn>
				<units>Per Month</units>
			</flow>
			<aux name="ARPTC">
				<doc>Average GP</doc>
				<eqn>SAFEDIV(DT*Cum_RPTC, MAX(TIME, 0), 0)</eqn>
				<units>unitless</units>
			</aux>
			<stock name="DW">
				<doc>Disabled Workers </doc>
				<eqn>0</eqn>
				<inflow>Inc</inflow>
				<outflow>Recv</outflow>
				<non_negative/>
				<units>Trabajadores</units>
			</stock>
			<flow name="Inc">
				<doc>Incapacitations</doc>
				<eqn>OD*DR</eqn>
				<non_negative/>
				<units>Trabajadores/mo</units>
			</flow>
			<flow name="Recv">
				<doc>Recovered</doc>
				<eqn>DW/RT</eqn>
				<non_negative/>
				<units>Trabajadores/mo</units>
			</flow>
			<aux name="DR">
				<doc>Disabled Rate</doc>
				<eqn>0.5</eqn>
				<units>Per Month</units>
			</aux>
			<aux name="RT">
				<doc>Recover Time</doc>
				<eqn>0.2</eqn>
				<units>Months</units>
			</aux>
			<aux name="TWr">
				<doc>Total Workers </doc>
				<eqn>DW + W</eqn>
				<isee:summing/>
				<units>Trabajadores</units>
			</aux>
			<aux name="ODC">
				<doc>OD Cost</doc>
				<eqn>OD*MODC</eqn>
				<units>USD/mo</units>
			</aux>
			<aux name="MODC">
				<doc>Marginal OD Cost</doc>
				<eqn>828</eqn>
				<units>USD/(mo*Trabajador)</units>
			</aux>
			<aux name="FCEC">
				<doc>FCE Cost</doc>
				<eqn>FCE*MFCEC</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="MFCEC">
				<doc>Marginal FCE Cost</doc>
				<eqn>250</eqn>
				<units>US Dollars/(mo*Trabajador)</units>
			</aux>
			<aux name="MWCAC">
				<doc>Marginal Worker Cost in a Collective Agreement</doc>
				<eqn>250</eqn>
				<units>US Dollars/(mo*Trabajadores)</units>
			</aux>
			<aux name="WCAC">
				<doc>WCA Cost</doc>
				<eqn>WCA*MWCAC</eqn>
				<units>US Dollars/mo</units>
			</aux>
			<aux name="IA">
				<doc>Initial Assets</doc>
				<eqn>276492461</eqn>
				<units>US Dollars</units>
			</aux>
			<aux name="AER">
				<doc>Asset&apos;s Exchange Rate</doc>
				<eqn>1352079</eqn>
				<units>US Dollars/Month</units>
			</aux>
			<aux name="ROAMT">
				<doc>ROA&apos;s Measurement Time</doc>
				<eqn>12</eqn>
				<units>mo</units>
			</aux>
			<aux name="PEFgr">
				<doc>Production Emissions Factor in grams</doc>
				<eqn>100</eqn>
				<units>Gr/Unidades</units>
			</aux>
			<aux name="grT">
				<eqn>1e6</eqn>
				<units>Gr/Tons</units>
			</aux>
			<aux name="RPTC">
				<doc>Return on production total cost</doc>
				<eqn>(SR-TPC)/TPC</eqn>
				<units>unitless</units>
			</aux>
			<aux name="MaxSocKPI">
				<dimensions>
					<dim name="Social"/>
				</dimensions>
				<element subscript="1">
					<eqn>100</eqn>
				</element>
				<element subscript="2">
					<eqn>100</eqn>
				</element>
				<element subscript="3">
					<eqn>200</eqn>
				</element>
				<element subscript="4">
					<eqn>100</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="MaxEnvKPI">
				<dimensions>
					<dim name="Ambiental"/>
				</dimensions>
				<eqn>100</eqn>
				<units>unitless</units>
			</aux>
			<aux name="MaxEcoKPI">
				<dimensions>
					<dim name="Económico"/>
				</dimensions>
				<eqn>100</eqn>
				<units>unitless</units>
			</aux>
			<aux name="T">
				<doc>Time to estimate Total Salary Expected Cost</doc>
				<eqn>6</eqn>
				<units>Months</units>
			</aux>
			<aux name="ATDEW">
				<eqn>3</eqn>
				<units>Months</units>
			</aux>
		</variables>
