&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:8pt; font-style:italic; color:#000000;&quot;&gt;Esto es una posible consecuencia de la cantidad de emisiones generadas,&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Arial&apos;; font-size:8pt; font-weight:700; font-style:italic; color:#000000;&quot;&gt; donde a mayor generación de emisiones, tendremos una menor capacidad de absorción&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text>
							</popup>
						</isee:annotation>
					</view>
