			<view isee:template_view="template:5" isee:name="Introduction" isee:original_design="Deluxe Tabbed Green Purple" background="white" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<graphics_frame border_color="#86ABA8" fill="none" x="109.855" y="51.356" width="989.108" height="553.641">
					<image width="0" height="0" size_to_parent="false" isee:transparency="0.8" isee:fixed_aspect_ratio="true">D:/Documents/TRABAJOS/Modelo Sostenibilidad Universidad Militar/Sostenibilidad.jpg</image>
				</graphics_frame>
				<isee:shape border_width="thin" border_style="none" opacity="0.6" transparent_background="false" corner_radius="41" x="572.824" y="118.314" width="438.667" height="419.725" kind="rectangle"/>
				<text_box z_index="5" font_weight="bold" font_color="#6551F1" font_size="36pt" padding="15" border_color="#81B29A" border_width="thick" appearance="transparent" x="585.527" y="120.722" width="404" height="103.667">A system dynamics model</text_box>
				<text_box z_index="5" font_size="14pt" padding="20" border_color="#81B29A" border_width="thick" vertical_scrollbar="true" appearance="transparent" x="588.148" y="240.722" width="418.667" height="281.079">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9.75pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:12pt; color:#000000;&quot;&gt;Currently, the business performance is assessed from a &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700; color:#000000;&quot;&gt;business sustainability&lt;/span&gt;&lt;span style=&quot; font-size:12pt; color:#000000;&quot;&gt; perspective. In this way, the economic dimension stops being the protagonist and social and environmental dimensions emerge as a priority as well. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:12pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:12pt; color:#000000;&quot;&gt;This dashboard presents a system dynamics model that helps organizations assess the impact of resource allocation through a set of economic, environmental, and social indicators across different productive system configurations.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<graphics_frame fill="none" x="163" y="70.1765" width="398" height="498">
					<image width="391" height="637" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Imagenes/CL_Production-removebg-preview.png</image>
				</graphics_frame>
			</view>
