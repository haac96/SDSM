						<text_box font_weight="bold" text_align="center" font_size="24pt" appearance="transparent" x="225.8" y="43.4476" width="614.4" height="59.6">Ciclo de realimentación - Emisiones de gases de efecto invernadero</text_box>
						<isee:annotation launcher_label="" show_by_default="true" hide_launcher="true" launch_on_hover="false" x="615.455" y="394.545">
							<popup x="576.5" y="119.364" width="202.455" height="107.273">
								<text>Las empresas en el sector manufacturero se caracterizan por tener un inventario (Stock) el cual tiene como entrada la producción (Production) y como salida sus entregas (Deliveries)</text>
							</popup>
						</isee:annotation>
					</view>
