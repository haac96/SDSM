							<popup x="663.773" y="368.455" width="181.545" height="75.4545">
								<text>Las entregas estarán en función de las ordenes de la demanda que se proyecte</text>
							</popup>
						</isee:annotation>
						<isee:annotation launcher_label="" show_by_default="true" hide_launcher="true" launch_on_hover="false" x="365.455" y="514.545">
							<popup x="350.136" y="447.545" width="164.273" height="74.5455">
								<text>La producción estará en función en primer lugar de la fuerza laboral y su productividad</text>
							</popup>
						</isee:annotation>
						<isee:annotation launcher_label="" show_by_default="true" hide_launcher="true" launch_on_hover="false" x="574.545" y="70">
