			<view isee:template_view="template:3" isee:name="Presentación" isee:original_design="Deluxe Tabbed Green Purple" background="white" page_width="1066" page_height="600" zoom="110" home_view="true" type="interface">
				<style/>
				<text_box z_index="1" text_align="center" vertical_text_align="bottom" font_family="Trebuchet MS" font_size="72pt" appearance="transparent" x="55.882" y="139.123" width="947.059" height="102.706">Sostenibilidad Empresarial</text_box>
				<text_box z_index="2" text_align="center" vertical_text_align="bottom" font_color="#353535" font_size="16pt" appearance="transparent" x="251.176" y="241.829" width="570.588" height="180.877">Un modelo de simulación mediante dinámica de sistemas que brinda indicadores ambientales, sociales y económicos
Autores: 
Harol Avila
Liliana Ruíz
Mario Muñoz
David Camargo</text_box>
				<button z_index="2" background="#6551F1" font_color="white" font_family="Open Sans" font_size="18pt" border_color="#959595" corner_radius="15" label="¡Iniciar!" isee:tooltip="" x="463.882" y="445.294" width="131.059" height="50">
					<actions>
						<action target="next_page">navigate</action>
					</actions>
				</button>
				<isee:shape background="#4CC1B7" border_width="thin" border_style="none" transparent_background="false" corner_radius="101" x="177.647" y="371.038" width="703.529" height="159.882" kind="rectangle"/>
				<isee:shape background="#A6E0DC" border_width="thin" border_style="none" transparent_background="false" x="1.17057" y="-0.401341" width="1114.12" height="491.765" kind="rectangle"/>
				<graphics_frame fill="none" x="103.154" y="6.765" width="100" height="100">
					<image width="722" height="722" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Imagenes/Melbourne University icon.jpeg</image>
				</graphics_frame>
				<graphics_frame fill="none" x="802" y="-0.46154" width="262" height="100">
					<image width="300" height="69" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Imagenes/Optima icon.jpeg</image>
				</graphics_frame>
			</view>
			<view isee:template_view="template:5" isee:name="Introducción" isee:original_design="Deluxe Tabbed Green Purple" background="white" page_width="1066" page_height="600" zoom="110" type="interface">
				<style/>
				<graphics_frame border_color="#86ABA8" fill="none" x="109.855" y="51.356" width="989.108" height="553.641">
					<image width="0" height="0" size_to_parent="false" isee:transparency="0.8" isee:fixed_aspect_ratio="true">D:/Documents/TRABAJOS/Modelo Sostenibilidad Universidad Militar/Sostenibilidad.jpg</image>
				</graphics_frame>
				<isee:shape border_width="thin" border_style="none" opacity="0.6" transparent_background="false" corner_radius="41" x="572.824" y="118.314" width="438.667" height="419.725" kind="rectangle"/>
				<text_box z_index="5" font_weight="bold" font_color="#6551F1" font_size="36pt" padding="15" border_color="#81B29A" border_width="thick" appearance="transparent" x="585.527" y="120.722" width="404" height="103.667">Un modelo de dinámica de sistemas</text_box>
				<text_box z_index="5" font_size="14pt" padding="20" border_color="#81B29A" border_width="thick" vertical_scrollbar="true" appearance="transparent" x="588.148" y="240.722" width="418.667" height="281.079">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:12pt; color:#000000;&quot;&gt;Actualmente el rendimiento de las empresas es evaluado desde la &lt;/span&gt;&lt;span style=&quot; font-size:12pt; font-weight:700; color:#000000;&quot;&gt;perspectiva de la sostenibilidad&lt;/span&gt;&lt;span style=&quot; font-size:12pt; color:#000000;&quot;&gt; empresarial, de esta manera la dimensión económica deja de ser la protagonista y las dimensiones social y ambiental emergen como prioridad. En esta presentación se mostrará un modelo de simulación dinámica que ayuda a las organizaciones a evaluar el impacto de la asignación de recursos mediante un conjunto de indicadores económicos, ambientales y sociales bajo distintas configuraciones del sistema productivo.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text_box>
				<graphics_frame fill="none" x="163" y="70.1765" width="398" height="498">
					<image width="391" height="637" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Imagenes/CL_Production-removebg-preview.png</image>
				</graphics_frame>
				<graphics_frame z_index="6" fill="none" x="6" y="115" width="100" height="100">
					<image width="722" height="722" size_to_parent="true" isee:transparency="0" isee:fixed_aspect_ratio="true">r../Imagenes/Melbourne University icon.jpeg</image>
				</graphics_frame>
			</view>
